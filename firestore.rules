rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Convidados podem ler o convite e registrar/atualizar a própria confirmação
    match /guests/{id} {
      allow read, create, update: if true;
      allow delete: if true; // exclusão feita pelo painel do organizador
    }
    // Configurações do site (nomes, data, local...)
    match /config/{id} {
      allow read: if true;
      allow write: if true;
    }
    // Checklist e orçamento (painel do organizador)
    match /tasks/{id} { allow read, write: if true; }
    match /expenses/{id} { allow read, write: if true; }
    // Bloqueia qualquer outra coleção
    match /{document=**} { allow read, write: if false; }
  }
}
